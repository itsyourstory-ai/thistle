# Supabase — get these from your Supabase project dashboard (Settings → API)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Dev-only flags (never set in production)
# VITE_DEV_AUTH_BYPASS=1    # skip login, mount mock session
# VITE_DEV_TEST_MODE=1      # auto-enable AI mock harness

# Placeholder Supabase creds -- lets the app boot without real credentials
# when using auth bypass + test mode. Replace with real values for live work.
# VITE_SUPABASE_URL=https://placeholder.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=placeholder-anon-key

# Loops email platform (server-side / edge function secrets — never VITE_-prefixed)
# LOOPS_API_KEY=           # get from Loops dashboard → Settings → API Keys
# LOOPS_TRANSPORT=mock     # set to "live" in production; "mock" for local dev + tests
