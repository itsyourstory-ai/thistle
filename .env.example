# Copy to .env and fill in with your Supabase project's values.
# These VITE_ vars are exposed in the browser bundle by design — they are the
# public/publishable Supabase credentials, protected by Row-Level Security.
# Real secrets (service-role key, AI/Drive API keys) live in Supabase Edge
# Function secrets, NOT here.

VITE_SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
